require 'pathname'

bindir = Pathname.new(__FILE__).realpath.dirname
$LOAD_PATH.unshift((bindir + '../lib').realpath)

require 'review/ast/command/volume_printer'

begin
  Signal.trap(:INT) { exit 1 }
  Signal.trap(:PIPE, 'IGNORE') unless RUBY_PLATFORM.match?(/mswin(?!ce)|mingw|cygwin|bccwin/)
  ReVIEW::AST::Command::VolumePrinter.execute(*ARGV)
rescue Errno::EPIPE
  exit 0
end
