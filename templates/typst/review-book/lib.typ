// review-book: a Typst book library for Re:VIEW manuscripts.
//
// Two public namespaces, for two different callers
// (doc/typst-review-book.md):
//
//   book.*   -- the stable API for hand-written Typst documents
//   review.* -- the Re:VIEW compatibility API, generated by TypstRenderer
//
// A hand-written document should import `book`; `review` exists so the
// generated chapter files never have to state layout.
//
// The version is kept in step with the review-ast gem that ships this copy.

#let version = "0.1.0"

#import "book.typ"
#import "review.typ"
#import "theme.typ": default-theme, merge-theme
