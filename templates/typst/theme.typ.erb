// Starter theme, generated by review-ast TypstMaker into the build directory
// when the project has no theme.typ of its own. The build directory is
// rebuilt every run, so editing this copy has no lasting effect.
//
// To change the look of the book (trim size, fonts, spacing, colours), put a
// theme.typ next to config.yml; the build copies it in as-is. Nothing here
// decides what an element means, so a change never requires regenerating a
// chapter (doc/typst-review-book.md).

#import "/lib/review-book/theme.typ": default-theme, merge-theme

#let theme = merge-theme(default-theme, (
  paper: <%= paper %>,
  // Free-form set/show rules go into `hooks`; they win over the library
  // defaults but are outside the parity guarantees:
  // hooks: doc => {
  //   show raw: set text(font: ("PlemolJP", "Menlo"))
  //   doc
  // },
))
