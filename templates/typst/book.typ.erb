// Generated by review-ast TypstMaker. Do not edit; edit the manuscript or
// theme.typ instead.
//
// The book parts are switched HERE, at the top level of the root file, rather
// than inside a wrapper function: a `set` only affects the content its function
// returns, so per-part page numbering has to be applied in the scope the
// chapters are included into (doc/typst-review-book.md).
//
// Values arrive as objects that know how to spell themselves: `.content` is
// escaped markup for a content argument, `.literal` a quoted string for a str
// argument. Choosing between the two is the only decision this template makes.

#import "/lib/review-book/lib.typ": book, review
#import "/theme.typ": theme

#show: book.document.with(
  metadata: (
    title: <%= book.metadata.title.content %>,
    plain-title: <%= book.metadata.title.literal %>,
<% if book.metadata.subtitle %>    subtitle: <%= book.metadata.subtitle.content %>,
<% end %>    authors: (<% book.metadata.authors.each do |author| %>(name: <%= author.name.content %>, plain-name: <%= author.name.literal %>, role: "author"), <% end %>),
<% if book.metadata.publisher %>    publisher: <%= book.metadata.publisher.content %>,
<% end %>    language: <%= book.metadata.language.literal %>,
    keywords: (<% book.metadata.keywords.each do |keyword| %><%= keyword.literal %>, <% end %>),
  ),
  theme: <%= book.theme.expression %>,
)

// The author's escape hatch: `hooks` in theme.typ is a document transform
// applied inside book.document, so its set/show rules win over the library
// defaults. Anything written there is outside the parity contract
// (doc/typst-review-book.md).
#show: if theme.at("hooks", default: none) == none { doc => doc } else { theme.hooks }
<% if book.front_matter.cover? %>
#review.cover(theme: <%= book.theme.expression %>, image-path: <%= book.front_matter.cover_image.literal %>, title: <%= book.metadata.title.content %>, authors: ((name: <%= book.metadata.author_line.content %>),)<% if book.front_matter.cover_forced? %>, force: true<% end %>)
<% end %>
<% if book.front_matter.titlepage? %>
#review.titlepage(title: <%= book.metadata.title.content %><% if book.metadata.subtitle %>, subtitle: <%= book.metadata.subtitle.content %><% end %>, authors: ((name: <%= book.metadata.author_line.content %>),)<% if book.metadata.publisher %>, publisher: <%= book.metadata.publisher.content %><% end %>)
<% end %>
#show: book.frontmatter
<% if book.front_matter.toc? %>
#review.toc(title: <%= book.front_matter.toc_title.content %><% if book.front_matter.toc_depth %>, depth: <%= book.front_matter.toc_depth %><% end %>)
<% end %>
<% chapters.predef.each do |file| %>
#include "/chapters/<%= file.basename %>.typ"
<% end %>
<% unless chapters.chaps.empty? %>
#show: book.mainmatter
<% chapters.chaps.each do |file| %>
#include "/chapters/<%= file.basename %>.typ"
<% end %>
<% end %>
<% unless chapters.appendix.empty? %>
#show: book.appendix
<% chapters.appendix.each do |file| %>
#include "/chapters/<%= file.basename %>.typ"
<% end %>
<% end %>
<% unless chapters.postdef.empty? %>
#show: book.backmatter
<% chapters.postdef.each do |file| %>
#include "/chapters/<%= file.basename %>.typ"
<% end %>
<% end %>
<% if book.index.wanted? %>
#review.print-index(title: <%= book.index.title.content %>)
<% end %>
<% if book.colophon.wanted? %>
#review.colophon(book-title: <%= book.metadata.title.content %>, entries: (<% book.colophon.entries.each do |entry| %>(<%= entry.label.content %>, <%= entry.value.content %>), <% end %>), history: (<% book.colophon.history.each do |line| %><%= line.content %>, <% end %>)<% if book.colophon.rights %>, rights: <%= book.colophon.rights.content %><% end %>)
<% end %>
